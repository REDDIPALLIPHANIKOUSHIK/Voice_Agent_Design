# ============================================================
# Home Credit LAP AI Voice Agent - Environment Configuration
# ============================================================

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Agent Identity
COMPANY_NAME=Home Credit
AGENT_NAME=Ananya
AGENT_GENDER=female
DEFAULT_LANGUAGE=English
# Supported: English, Hindi

# Optional LLM API Configuration (OpenAI / Anthropic / Groq)
# Required only if using live cloud LLM fallback for conversational responses
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Voice Provider Integrations (Retell AI / Bolna)
RETELL_API_KEY=your_retell_api_key_here
RETELL_AGENT_ID=your_retell_agent_id_here

BOLNA_API_KEY=your_bolna_api_key_here
BOLNA_AGENT_ID=your_bolna_agent_id_here

# Speech Synthesis / Recognition (Offline / Cloud)
TTS_ENGINE=web_speech
# Options: web_speech, gtts, elevenlabs
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
